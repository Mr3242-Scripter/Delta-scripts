---------------------------------------------------
-- HTTP
---------------------------------------------------
local function httpGet(url, retries)
    retries = retries or 3

    for i = 1, retries do
        local ok, res = pcall(function()
            return game:HttpGet(url)
        end)

        if ok and type(res) == "string" and #res > 0 then
            return res
        end

        task.wait(0.25 * i)
    end

    return nil
end

---------------------------------------------------
-- CLEAN TEXT
---------------------------------------------------
local function clean(text)
    return (text or "")
        :gsub("&amp;", "&")
        :gsub("&quot;", '"')
        :gsub("&#39;", "'")
        :gsub("<.->", "")
        :gsub("%s+", " ")
        :match("^%s*(.-)%s*$")
end

---------------------------------------------------
-- URL ENCODE
---------------------------------------------------
local function urlEncode(str)
    return tostring(str)
        :gsub("([^%w%-_%.~])", function(c)
            return string.format("%%%02X", string.byte(c))
        end)
end

---------------------------------------------------
-- CATEGORY DETECTION
---------------------------------------------------
local function getCategory(name)
    local n = name:lower()

    if n:find("admin", 1, true) then
        return "Admin"
    elseif n:find("hub", 1, true) then
        return "Hub"
    elseif n:find("fly", 1, true)
        or n:find("esp", 1, true)
        or n:find("teleport", 1, true) then
        return "Exploits"
    elseif n:find("tool", 1, true)
        or n:find("gui", 1, true) then
        return "Tools"
    elseif n:find("game", 1, true)
        or n:find("obby", 1, true)
        or n:find("simulator", 1, true) then
        return "Games"
    end

    return "Misc"
end

---------------------------------------------------
-- STORAGE
---------------------------------------------------
local seen = {}

local function addScript(name, url)
    name = clean(name)

    if name == "" or isBlocked(name) or seen[url] then
        return
    end

    seen[url] = true

    local cat = getCategory(name)

    table.insert(categories[cat], {
        name = name,
        url = url
    })
end

---------------------------------------------------
-- PARSE PRIMARY LIST
---------------------------------------------------
local function parsePrimary(data)
    for line in data:gmatch("[^\r\n]+") do
        local name, url = line:match("^(.-)%s*=%s*(https://pastebin%.com/raw/%w+)")

        if name and url then
            addScript(name, url)
        end
    end
end

---------------------------------------------------
-- PARSE GITHUB FOLDER
---------------------------------------------------
local function parseGitHub(data)
    for name in data:gmatch('"name"%s*:%s*"([^"]+)"') do
        if name ~= "QuantumX Script list" then
            local displayName = name:gsub("%.txt$", "")
            local encodedName = urlEncode(name)
            local url = GITHUB_RAW_BASE .. encodedName

            addScript(displayName, url)
        end
    end
end

---------------------------------------------------
-- RUN SCRIPT
---------------------------------------------------
local function runScript(url)

    local content = httpGet(url, 3)

    if not content or #content < 20 then
        Notify("Error", "Failed to load script")
        return
    end

    local lower = content:lower()

    if lower:find("<html", 1, true)
        or lower:find("<!doctype", 1, true) then
        Notify("Error", "Invalid script response")
        return
    end

    pcall(function()
        Rayfield:Destroy()
    end)

    task.wait(0.1)

    local ok, err = pcall(function()
        local fn = loadstring(content)

        if not fn then
            error("loadstring failed")
        end

        fn()
    end)

    if not ok then
        Notify("Execution Error", tostring(err or "Unknown error"))
    end
end

